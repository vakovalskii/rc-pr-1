[Unit]
Description=RC-багги: камера и ESP8266 по UART, подключение к релею на Pi 4 по USB-кабелю
After=network-online.target rc-usbnet.service
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/rc
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/python3 -u pi_car.py --esp /dev/serial0 --rotate180 --bitrate 3000000 --max-throttle 1 --max-reverse 1 --url ws://10.55.0.1:8080/ws/car
Restart=always
RestartSec=2
TimeoutStopSec=3

[Install]
WantedBy=multi-user.target
