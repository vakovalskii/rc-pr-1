[Unit]
Description=RC-багги: RealSense D455 -> релей на Pi Zero (окно глубины в пульте)
After=network-online.target
Wants=network-online.target
# перезапускать без ограничения: камера может пропадать с USB надолго
StartLimitIntervalSec=0

[Service]
User=pi
WorkingDirectory=/home/pi/rc
ExecStart=/home/pi/rs-venv/bin/python -u /home/pi/rc/depth_cam.py --reset --watchdog 5 --serve 8090 --color --raw-fps 5 --view-fps 8 --url ws://192.168.1.137:8080/ws/depth
Restart=always
RestartSec=3
TimeoutStopSec=5
KillMode=mixed

[Install]
WantedBy=multi-user.target
