[Unit]
Description=RC-багги: RealSense D455 -> релей на Pi Zero (окно глубины в пульте)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/rc
ExecStart=/home/pi/rs-venv/bin/python -u /home/pi/rc/depth_cam.py --url ws://192.168.1.137:8080/ws/depth
Restart=always
RestartSec=3
TimeoutStopSec=3

[Install]
WantedBy=multi-user.target
